# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Sign sessions with a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me
JWT_TTL=7d
COOKIE_NAME=atc_session

# Sites allowed to call this API with cookies (comma separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Database -------------------------------------------------------------
# Leave DATABASE_URL blank and the API runs on a local JSON file (server/data/db.json).
# Set it to a Postgres connection string and the Postgres adapter takes over
# automatically, with no application code changes. Then run: npm run db:migrate
# DATABASE_URL=postgresql://user:password@host:5432/atcsports
